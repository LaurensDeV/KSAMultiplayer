<Project>

  <!--
    Where the KSA assemblies the mod compiles against come from. They are RocketWerkz's copyrighted
    files and are never committed. First match wins: KSA_DLL_DIR, then Import/, then a
    ksa-game-assemblies checkout beside this repository, then a game install.

    Only the mod needs them. The protocol, the server and the tests reference nothing of KSA.
  -->
  <PropertyGroup>
    <KsaDllDir Condition="'$(KsaDllDir)' == '' AND '$(KSA_DLL_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(KSA_DLL_DIR)'))</KsaDllDir>
    <KsaDllDir Condition="'$(KsaDllDir)' == '' AND Exists('$(MSBuildThisFileDirectory)Import/KSA.dll')">$(MSBuildThisFileDirectory)Import/</KsaDllDir>
    <KsaDllDir Condition="'$(KsaDllDir)' == '' AND Exists('$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll/KSA.dll')">$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll/</KsaDllDir>
    <KsaDllDir Condition="'$(KsaDllDir)' == '' AND Exists('C:\Program Files\Kitten Space Agency\KSA.dll')">C:\Program Files\Kitten Space Agency\</KsaDllDir>
    <KsaDllDir Condition="'$(KsaDllDir)' == '' AND Exists('$(HOME)/.local/share/Steam/steamapps/common/Kitten Space Agency/KSA.dll')">$(HOME)/.local/share/Steam/steamapps/common/Kitten Space Agency/</KsaDllDir>
    <KsaDllDir Condition="'$(KsaDllDir)' == '' AND Exists('/mnt/c/Program Files/Kitten Space Agency/KSA.dll')">/mnt/c/Program Files/Kitten Space Agency/</KsaDllDir>
  </PropertyGroup>

  <!--
    Discord's Social SDK, unpacked as Discord hands it out: include/, lib/, bin/. It is Discord's to
    distribute and its terms forbid redistributing it, so it is never committed either. First match
    wins: DISCORD_SDK_DIR, then Import/discord_social_sdk/, then a discord_social_sdk checkout beside
    this repository. Without one the mod is built without Discord, and runs without it.
  -->
  <PropertyGroup>
    <DiscordSdkDir Condition="'$(DiscordSdkDir)' == '' AND '$(DISCORD_SDK_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(DISCORD_SDK_DIR)'))</DiscordSdkDir>
    <DiscordSdkDir Condition="'$(DiscordSdkDir)' == '' AND Exists('$(MSBuildThisFileDirectory)Import/discord_social_sdk/include/cdiscord.h')">$(MSBuildThisFileDirectory)Import/discord_social_sdk/</DiscordSdkDir>
    <DiscordSdkDir Condition="'$(DiscordSdkDir)' == '' AND Exists('$(MSBuildThisFileDirectory)../discord_social_sdk/discord_social_sdk/include/cdiscord.h')">$(MSBuildThisFileDirectory)../discord_social_sdk/discord_social_sdk/</DiscordSdkDir>
  </PropertyGroup>

  <!--
    The Discord application the mod speaks as. Discord's Developer Terms count an application id as
    a developer credential, which "may not be embedded in open source projects" (2(d)), so it is
    given to the build and never written in the source: DISCORD_APPLICATION_ID, or
    Import/discord-application-id.txt. Without one the mod has no Discord.
  -->
  <PropertyGroup>
    <DiscordApplicationId Condition="'$(DiscordApplicationId)' == '' AND '$(DISCORD_APPLICATION_ID)' != ''">$(DISCORD_APPLICATION_ID)</DiscordApplicationId>
    <DiscordApplicationId Condition="'$(DiscordApplicationId)' == '' AND Exists('$(MSBuildThisFileDirectory)Import/discord-application-id.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Import/discord-application-id.txt').Trim())</DiscordApplicationId>
  </PropertyGroup>

  <!--
    A game install has KSA.dll but not StarMap's or Harmony's assemblies, which the mod also needs;
    say so plainly rather than with a wall of missing types.
  -->
  <Target Name="KsaMpCheckAssemblies" BeforeTargets="CoreCompile" Condition="'$(NeedsKsa)' == 'true'">
    <Error Condition="'$(KsaDllDir)' == '' OR !Exists('$(KsaDllDir)KSA.dll') OR !Exists('$(KsaDllDir)StarMap.API.dll') OR !Exists('$(KsaDllDir)0Harmony.dll')"
           Text="The mod needs KSA.dll, StarMap.API.dll and 0Harmony.dll in one folder, and none was found with all three (looked in: '$(KsaDllDir)'). Point KSA_DLL_DIR at one, for example a copy of the game's folder with StarMap installed in it. They are copyrighted: never commit them. The server and the tests need none of this." />
  </Target>

</Project>
