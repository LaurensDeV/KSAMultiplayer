# Copy to .env (gitignored, mode 600) and fill in:
#   set -a && source .env && set +a

# The digest the Server image workflow printed in its summary. The image is public, so the machine
# pulls it without a token.
export TF_VAR_server_image=

# The same, from the Directory image workflow. Empty means the directory is NOT DEPLOYED, so an
# apply that leaves this out plans away the container behind servers.ksarmory.com. Set both.
export TF_VAR_directory_image=

# Only if the machine or the key is not the default in variables.tf.
# export TF_VAR_vps_host=
# export TF_VAR_ssh_private_key=

# Other worlds on this machine, as HCL, each on a port of its own. The DNS layer's `worlds` must
# agree: that is where the name and its SRV record come from. Empty by default.
#
#   export TF_VAR_worlds='{ mpcars = { port = 50101 } }'
