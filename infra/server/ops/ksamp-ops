#!/usr/bin/python3 -I
# What `ssh ops@ksamp.gg` runs, as the ops user, whatever is asked: sshd forces it. With words after
# the address it runs them once; without, it is a prompt that runs each line the same way. Either
# way it decides nothing but who is asking, and hands the words to ksamp-ops-root, which alone has
# the rules, so they are written once and read as root.
#
# Who is asking comes from the key sshd accepted (ExposeAuthInfo), never from anything sent: the
# name goes into the machine's log beside every restart.

import os
import signal
import subprocess
import sys

KEYS = "/etc/ksamp-ops/keys"
ROOT = "/usr/local/libexec/ksamp-ops-root"
SUDO = ["/usr/bin/sudo", "-n", "--", ROOT]
# A prompt nobody types at is a session nobody is watching.
IDLE_SECONDS = 1800


def refuse(why: str) -> None:
    print(f"ksamp-ops: {why}", file=sys.stderr)
    sys.exit(1)


def who() -> str:
    # Each line of SSH_USER_AUTH is a method that succeeded: "publickey <type> <base64>".
    try:
        with open(os.environ["SSH_USER_AUTH"], encoding="ascii") as f:
            used = [line.split()[1:3] for line in f if line.startswith("publickey ")]
        with open(KEYS, encoding="ascii") as f:
            known = {tuple(line.split()[1:3]): line.split()[0] for line in f if len(line.split()) == 3}
    except (KeyError, OSError, IndexError, UnicodeDecodeError):
        refuse("this login did not say which key it used")
    for key in used:
        if tuple(key) in known:
            return known[tuple(key)]
    refuse("the key this login used is not one of the operators'")
    raise AssertionError


def checked(words: list[str]) -> bool:
    # Long before anything real: these are a verb, a container and a number.
    if len(words) > 4 or any(len(w) > 64 for w in words):
        print("ksamp-ops: that is not a command; help says what is", file=sys.stderr)
        return False
    return True


def idle(_signum, _frame) -> None:
    print(f"\nnothing typed for {IDLE_SECONDS // 60} minutes: goodbye")
    sys.exit(0)


def prompt(name: str) -> None:
    try:
        import readline  # noqa: F401 -- arrow keys and history for input()
    except ImportError:
        pass
    signal.signal(signal.SIGALRM, idle)
    print(f"ksamp.gg as {name}. help lists the commands; exit or Ctrl+D leaves.")
    while True:
        signal.alarm(IDLE_SECONDS)
        try:
            words = input("ops> ").split()
        except EOFError:
            print()
            return
        except KeyboardInterrupt:
            print()
            continue
        signal.alarm(0)
        if not words:
            continue
        if words in (["exit"], ["quit"], ["logout"]):
            return
        if checked(words):
            # Ctrl+C is the command's to answer -- it ends a follow -- and not a reason to leave:
            # a handler, unlike SIG_IGN, is not inherited by what is run.
            signal.signal(signal.SIGINT, lambda *_: None)
            ran = subprocess.run([*SUDO, name, *words])
            signal.signal(signal.SIGINT, signal.default_int_handler)
            if ran.returncode in (130, -signal.SIGINT):
                print()


name = who()
words = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
if not words:
    prompt(name)
elif checked(words):
    os.execv(SUDO[0], [*SUDO, name, *words])
else:
    sys.exit(1)
