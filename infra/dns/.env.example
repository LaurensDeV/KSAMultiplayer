# Copy to .env (gitignored, mode 600) and fill in:
#   set -a && source .env && set +a
#
# The token needs Zone:Read and DNS:Edit, scoped to this zone alone. This layer owns one record and
# touches nothing else in the zone, so a token that can only edit DNS is all it ever wants.

export TF_VAR_cloudflare_api_token=
export TF_VAR_zone_id=

# The machine the server runs on.
export TF_VAR_vps_ipv4=
