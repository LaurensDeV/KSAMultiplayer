# Copy to .env (gitignored, mode 600) and fill in:
#   set -a && source .env && set +a
#
# The token needs Zone:Read and DNS:Edit, scoped to this zone alone. This layer owns its own records
# and touches nothing else in the zone, so a token that can only edit DNS is all it ever wants.

export TF_VAR_cloudflare_api_token=
export TF_VAR_zone_id=

# The machine the server runs on.
export TF_VAR_vps_ipv4=

# Other worlds on the same machine, each on a port of its own, as HCL. One address carries one UDP
# port once, so every world past the first needs one -- and because an address record cannot carry a
# port, each gets an SRV record beside it that says which. Empty by default.
#
#   export TF_VAR_worlds='{ mpcars = { port = 50101 } }'
