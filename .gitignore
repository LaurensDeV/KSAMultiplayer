# Game assemblies: RocketWerkz's copyrighted files, never committed.
Import/

bin/
obj/
dist/
*.user
.vs/
.idea/
.vscode/

# The two-games harness: a scratch world for the test server, and the logs of a run.
.two-games-data/
.two-games-server.log
.two-games-server.on
.two-games-server.trace
.two-games-relay.log
.two-games-lag.ms
.two-games-runs/
.two-games-run.log

# Infrastructure: credentials and local working files. The provider lock file is committed, so
# everyone plans against the same provider versions.
infra/**/.env
infra/**/backend.hcl
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.backup

# The isolated play profile, made by tools/play.sh on whatever machine it runs on.

# A saved plan: local, and a credential of sorts once variables are in it.
infra/**/tfplan

# Claude Code: the skills under .claude/skills/ are shared and tracked. These two are not content --
# per-machine permissions, and real git worktrees for parallel agents.
.claude/settings.local.json
.claude/worktrees/

# Python leaves these beside the bridge's driver.
__pycache__/
