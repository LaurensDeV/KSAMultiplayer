<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the server and the mod both speak, and nothing of KSA's: the server runs on a Linux box with
    no game on it. The mod compiles these same files into its own DLL rather than referencing this
    project, so a player installs one assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KSAMultiplayer</RootNamespace>
    <AssemblyName>KSAMultiplayer.Protocol</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
