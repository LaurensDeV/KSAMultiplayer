<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The dedicated server: a console program with nothing of KSA in it, so it runs on any Linux box
    .NET runs on. tools/publish-server.sh makes it one self-contained file for linux-x64 or arm64.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KSAMultiplayer.Server</RootNamespace>
    <AssemblyName>ksamp-server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.35.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Protocol\KSAMultiplayer.Protocol.csproj" />
  </ItemGroup>

  <!--
    The web viewer (src/Server/Web), off unless web-port is set: Kestrel inside this process, and
    the page compiled in as resources so the server is still one file.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="KSAMultiplayer.Tests" />
    <EmbeddedResource Include="Web\Page\*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The KSA build this server holds players to, from Directory.Build.props: read back in Program.cs. -->
  <ItemGroup>
    <AssemblyMetadata Include="KsaBuild" Value="$(KsaBuild)" />
  </ItemGroup>

  <!--
    Empty worlds, one folder per system, exactly as KSA wrote them. Carried in the assembly so a
    server can start with a world instead of waiting for a player to bring one: the server never
    reads them, it hands the bytes out as any other world, so nothing of KSA's format is known here.
  -->
  <ItemGroup>
    <EmbeddedResource Include="worlds\**\*" />
  </ItemGroup>

</Project>
