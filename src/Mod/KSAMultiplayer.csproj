<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Discord's Social SDK is a C library, called through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KSAMultiplayer</RootNamespace>
    <!-- StarMap loads "<EntryAssembly>.dll" from mod.toml, so this name must match it. -->
    <AssemblyName>KSAMultiplayer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.20.0</Version>
    <Product>KSAMultiplayer</Product>
    <NeedsKsa>true</NeedsKsa>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The protocol compiled in rather than referenced, so a player installs one assembly. -->
  <ItemGroup>
    <Compile Include="..\Protocol\**\*.cs" Exclude="..\Protocol\obj\**;..\Protocol\bin\**" Link="Protocol\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The loader's API and Harmony from NuGet, where StarMap publishes them, rather than from a copy of
    somebody's install: they are MIT and public, so there is no reason for the private mirror of KSA's
    copyrighted assemblies to be in the way of building this.

    ExcludeAssets="runtime" is what keeps a player installing one assembly. Both are already loaded in
    the KSA process (StarMap loads 0Harmony into the default context before the game starts), and a
    second copy on disk would be another type identity. The version is the floor this mod needs rather
    than the one it runs against: a mod's load context resolves these by name alone, and binds to
    whatever the loader already has.
  -->
  <ItemGroup>
    <PackageReference Include="StarMap.API" Version="0.5.3" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    KSA's own assemblies, compile-time only for the same reason. $(KsaDllDir) is resolved by
    Directory.Build.props.
  -->
  <ItemGroup>
    <Reference Include="$(KsaDllDir)KSA.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.Numerics.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.Core.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.Strings.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.ImGui.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.ImGui.Abstractions.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Brutal.Glfw.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Planet.Render.Core.dll" Private="false" />
    <Reference Include="$(KsaDllDir)Planet.Core.dll" Private="false" />
    <Reference Include="$(KsaDllDir)BepuUtilities.dll" Private="false" />
    <Reference Include="$(KsaDllDir)BepuPhysics.dll" Private="false" />
  </ItemGroup>

  <!--
    Discord's native library beside the mod, where Discord.cs loads it from, with the SDK's own
    notices. $(DiscordSdkDir) is resolved by Directory.Build.props; whichever platforms' builds it
    holds are the ones that go out.
  -->
  <!-- Read back by Discord.cs; resolved by Directory.Build.props, and never in the source. -->
  <ItemGroup Condition="'$(DiscordApplicationId)' != ''">
    <AssemblyMetadata Include="DiscordApplicationId" Value="$(DiscordApplicationId)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DiscordSdkDir)' != ''">
    <None Include="$(DiscordSdkDir)bin/release/discord_partner_sdk.dll" Condition="Exists('$(DiscordSdkDir)bin/release/discord_partner_sdk.dll')" Link="discord_partner_sdk.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(DiscordSdkDir)lib/release/libdiscord_partner_sdk.so" Condition="Exists('$(DiscordSdkDir)lib/release/libdiscord_partner_sdk.so')" Link="libdiscord_partner_sdk.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(DiscordSdkDir)License-Notices.txt" Condition="Exists('$(DiscordSdkDir)License-Notices.txt')" Link="discord-license-notices.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
