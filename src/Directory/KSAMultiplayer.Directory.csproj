<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A directory: the list of servers a browser reads, and the endpoint a server announces itself to.
    Nothing of KSA is in it, as nothing of KSA is in the protocol it speaks, so it runs anywhere .NET
    does. It compiles against the protocol rather than a copy of it: a directory's whole job is to
    ask servers what they are in the version they would be joined in, and a second implementation of
    that question is a second place to remember Wire.Version.

    Plural, because `KSAMultiplayer.Directory` would be a namespace whose name is also System.IO's,
    and inside anything under KSAMultiplayer the namespace wins: every Directory.CreateDirectory in
    the mod, the server and the tests stopped compiling.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KSAMultiplayer.Directories</RootNamespace>
    <AssemblyName>ksamp-directory</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.13.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Protocol\KSAMultiplayer.Protocol.csproj" />
  </ItemGroup>

</Project>
